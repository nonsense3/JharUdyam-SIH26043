# Copy this file to ".env" and paste in the two values from your Supabase project.
# Supabase dashboard -> Project Settings -> API
#
# 1. "Project URL"        -> VITE_SUPABASE_URL
# 2. "anon public" key    -> VITE_SUPABASE_ANON_KEY
#
# The anon key is safe to use in a browser app. Never put the "service_role"
# key in this file — that one bypasses all security rules.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
